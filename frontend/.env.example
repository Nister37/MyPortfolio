# Strapi CMS base URL — used at build time only, never exposed to the browser.
# For local development, the default http://localhost:1337 is used when this is unset.
STRAPI_URL=http://localhost:1337

# Read-only API token generated in the Strapi admin panel.
# Required when Strapi has API token protection enabled.
STRAPI_API_TOKEN=

# Optional Umami Cloud website ID. Analytics loads only in production when set.
# The value is a public site identifier, not a secret.
PUBLIC_UMAMI_WEBSITE_ID=

