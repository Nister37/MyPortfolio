---
import "../styles/global.css";
import "../styles/custom.scss";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CustomCursor from "../components/ui/CustomCursor.svelte";
import ScrollProgress from "../components/ui/ScrollProgress.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { layoutCopy, siteMetadata } from "../data/site-copy";
import { base } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: "en" | "pl";
  path?: string;
  localePaths?: Partial<Record<"en" | "pl", string>>;
}

const {
  title,
  description = siteMetadata.defaultDescription,
  ogImage,
  lang = "en",
  path = "/",
  localePaths,
} = Astro.props;
const copy = layoutCopy[lang];

const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? siteMetadata.url,
);
const socialImagePath = ogImage ?? `${base}social-card.svg`;
const resolvedOgImage = new URL(
  socialImagePath,
  Astro.site ?? siteMetadata.url,
);
const enUrl = new URL(
  getRelativeLocaleUrl("en", localePaths?.en ?? path),
  Astro.site ?? siteMetadata.url,
);
const plUrl = new URL(
  getRelativeLocaleUrl("pl", localePaths?.pl ?? path),
  Astro.site ?? siteMetadata.url,
);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteMetadata.name,
  url: siteMetadata.url,
  jobTitle: siteMetadata.jobTitle,
  description: siteMetadata.personDescription,
  sameAs: siteMetadata.sameAs,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteMetadata.portfolioName,
  url: siteMetadata.url,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={siteMetadata.name} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="pl" href={plUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMetadata.portfolioName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured data: Person + WebSite -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    <script
      is:inline
      defer
      src="https://umami-production-59f2.up.railway.app/script.js"
      data-website-id="65c6e9d8-5a34-48ea-b139-682c4fc8c6ca"></script>

    <title>{title}</title>
    <!-- Redirect legacy GitHub Pages project URLs to the custom domain.
         Those pages still render static HTML, but root-relative Svelte chunks
         like /_astro/CustomCursor... 404 under nister37.github.io/MyPortfolio. -->
    <script is:inline>
      (function () {
        const legacyHost = "nister37.github.io";
        const legacyBase = "/MyPortfolio";
        if (window.location.hostname !== legacyHost) return;
        if (
          window.location.pathname !== legacyBase &&
          !window.location.pathname.startsWith(legacyBase + "/")
        ) {
          return;
        }

        const path = window.location.pathname.slice(legacyBase.length) || "/";
        window.location.replace(
          "https://pawelryfiak.is-a.dev" +
            path +
            window.location.search +
            window.location.hash,
        );
      })();
    </script>
    <!-- Apply saved theme before first paint to prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("portfolio-theme");
        document.documentElement.setAttribute(
          "data-theme",
          saved === "portfolio-light" ? "portfolio-light" : "portfolio-dark",
        );
      })();
    </script>
  </head>
  <body
    class="bg-base-100 text-base-content flex min-h-dvh flex-col antialiased"
  >
    <ScrollProgress lang={lang} />
    <!-- Skip nav for keyboard users -->
    <a
      href="#main-content"
      class="focus:bg-primary focus:text-primary-content sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-md focus:px-4 focus:py-2"
    >
      {copy.skipToContent}
    </a>
    <div class="site-frame flex min-h-dvh flex-1 flex-col">
      <Header lang={lang} path={path} localePaths={localePaths} />
      <div class="flex flex-1 flex-col">
        <slot />
      </div>
      <Footer lang={lang} />
    </div>
    <CustomCursor client:load />
    <script>
      import "../scripts/details-animations";
      import "../scripts/reveal";
    </script>
  </body>
</html>
