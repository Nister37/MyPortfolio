---
import "../styles/global.css";
import "../styles/custom.scss";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CustomCursor from "../components/ui/CustomCursor.svelte";
import ScrollProgress from "../components/ui/ScrollProgress.astro";
import { layoutCopy, siteMetadata } from "../data/site-copy";
import { base } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: "en" | "pl";
  path?: string;
  localePaths?: Partial<Record<"en" | "pl", string>>;
}

const {
  title,
  description = siteMetadata.defaultDescription,
  ogImage,
  lang = "en",
  path = "/",
  localePaths,
} = Astro.props;
const copy = layoutCopy[lang];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteMetadata.url);
// Fall back to the site favicon so all pages have a shareable social image.
const resolvedOgImage = ogImage ?? `${base}favicon.svg`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteMetadata.name,
  url: siteMetadata.url,
  jobTitle: siteMetadata.jobTitle,
  description: siteMetadata.personDescription,
  sameAs: siteMetadata.sameAs,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteMetadata.portfolioName,
  url: siteMetadata.url,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={siteMetadata.name} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMetadata.portfolioName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Structured data: Person + WebSite -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <title>{title}</title>
    <!-- Redirect legacy GitHub Pages project URLs to the custom domain.
         Those pages still render static HTML, but root-relative Svelte chunks
         like /_astro/CustomCursor... 404 under nister37.github.io/MyPortfolio. -->
    <script is:inline>
      (function () {
        var legacyHost = "nister37.github.io";
        var legacyBase = "/MyPortfolio";
        if (window.location.hostname !== legacyHost) return;
        if (
          window.location.pathname !== legacyBase &&
          !window.location.pathname.startsWith(legacyBase + "/")
        ) {
          return;
        }

        var path = window.location.pathname.slice(legacyBase.length) || "/";
        window.location.replace(
          "https://pawelryfiak.is-a.dev" + path + window.location.search + window.location.hash
        );
      })();
    </script>
    <!-- Apply saved theme before first paint to prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("portfolio-theme");
        document.documentElement.setAttribute(
          "data-theme",
          saved === "portfolio-light" ? "portfolio-light" : "portfolio-dark"
        );
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-100 text-base-content antialiased">
    <ScrollProgress />
    <!-- Skip nav for keyboard users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-content"
    >
      {copy.skipToContent}
    </a>
    <Header lang={lang} path={path} localePaths={localePaths} />
    <slot />
    <Footer lang={lang} />
    <CustomCursor client:load />
    <script>
      import "../scripts/details-animations";
      import "../scripts/reveal";
    </script>
  </body>
</html>


















