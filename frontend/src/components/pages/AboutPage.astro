---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../layout/Section.astro";
import ContactCta from "../home/ContactCta.astro";
import { pageCopy } from "../../data/site-copy";
import type { Lang } from "../../data/site-copy";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const copy = pageCopy[lang].about;
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} path="/about">
  <main id="main-content">
    <Section>
      <div class="max-w-3xl" data-reveal>
        <h1 class="text-4xl font-bold tracking-tight">{copy.heading}</h1>

        <p class="mt-6 text-lg leading-relaxed text-base-content/80">
          {copy.intro}
        </p>

        {copy.paragraphs.map((paragraph) => (
          <p class="mt-4 leading-relaxed text-base-content/70">{paragraph}</p>
        ))}
      </div>
    </Section>

    <ContactCta lang={lang} />
  </main>
</BaseLayout>
