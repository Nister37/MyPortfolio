---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectFilter from "../projects/ProjectFilter.svelte";
import Section from "../layout/Section.astro";
import IconHeading from "../ui/IconHeading.astro";
import { pageCopy } from "../../data/site-copy";
import type { Lang } from "../../data/site-copy";
import { getProjects } from "../../lib/cms/projects";
import { base } from "../../lib/url";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const projects = await getProjects();
const copy = pageCopy[lang].projects;
const projectBase = lang === "pl" ? `${base}pl/projects/` : `${base}projects/`;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  path="/projects"
>
  <main id="main-content">
    <Section>
      <div data-reveal>
        <IconHeading
          icon="folder-kanban"
          class="text-4xl font-bold tracking-tight"
        >
          {copy.heading}
        </IconHeading>
        <p class="text-base-content/65 mt-3 max-w-2xl">
          {copy.intro}
        </p>
      </div>

      <div class="mt-10">
        <ProjectFilter
          client:load
          projects={projects}
          lang={lang}
          projectBase={projectBase}
        />
      </div>
    </Section>
  </main>
</BaseLayout>
