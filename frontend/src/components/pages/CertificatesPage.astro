---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CertificateLibrary from "../certificates/CertificateLibrary.svelte";
import Section from "../layout/Section.astro";
import { pageCopy } from "../../data/site-copy";
import type { Lang } from "../../data/site-copy";
import { getCertificatesByLanguage } from "../../lib/cms/certificates";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const certificates = await getCertificatesByLanguage(lang);
const copy = pageCopy[lang].certificates;
---

<BaseLayout title={copy.title} description={copy.description} lang={lang} path="/certificates">
  <main id="main-content">
    <Section>
      <div data-reveal>
        <h1 class="text-4xl font-bold tracking-tight">{copy.heading}</h1>
        <p class="mt-3 max-w-2xl text-base-content/65">
          {copy.intro}
        </p>
      </div>

      <div class="mt-10">
        <CertificateLibrary client:load certificates={certificates} lang={lang} />
      </div>
    </Section>
  </main>
</BaseLayout>
