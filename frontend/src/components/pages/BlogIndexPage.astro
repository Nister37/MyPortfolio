---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../blog/BlogCard.astro";
import Section from "../layout/Section.astro";
import IconHeading from "../ui/IconHeading.astro";
import { pageCopy } from "../../data/site-copy";
import type { Lang } from "../../data/site-copy";
import { getPostsByLanguage } from "../../lib/cms/posts";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const posts = await getPostsByLanguage(lang);
const copy = pageCopy[lang].blog;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  path="/blog"
>
  <main id="main-content">
    <Section>
      <div data-reveal>
        <IconHeading icon="book-open" class="text-4xl font-bold tracking-tight">
          {copy.heading}
        </IconHeading>
        <p class="text-base-content/65 mt-3 max-w-2xl">
          {copy.intro}
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} lang={lang} />)}
      </div>

      {
        posts.length === 0 && (
          <p class="text-base-content/50 mt-12 text-center">{copy.empty}</p>
        )
      }
    </Section>
  </main>
</BaseLayout>
