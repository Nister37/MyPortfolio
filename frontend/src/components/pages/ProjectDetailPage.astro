---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../layout/Section.astro";
import { projectDetailCopy, siteMetadata } from "../../data/site-copy";
import type { Lang } from "../../data/site-copy";
import { isGroupProject } from "../../lib/project-flags";
import type { Project } from "../../lib/cms/projects";
import { base } from "../../lib/url";

interface Props {
  project: Project;
  lang?: Lang;
}

const { project, lang = "en" } = Astro.props;
const copy = projectDetailCopy[lang];
const allProjectsHref =
  lang === "pl" ? `${base}pl/projects` : `${base}projects`;
const groupProject = isGroupProject(project);

const proseSections = [
  { heading: copy.problem, content: project.problem },
  { heading: copy.myRole, content: project.myRole },
  { heading: copy.architecture, content: project.architecture },
  { heading: copy.hardestProblem, content: project.hardestProblem },
  { heading: copy.lessonsLearned, content: project.lessonsLearned },
].filter((section) => section.content);
---

<BaseLayout
  title={`${project.title} | ${siteMetadata.name}`}
  description={project.summary}
  lang={lang}
  path={`/projects/${project.slug}`}
>
  <main id="main-content">
    <Section>
      <a class="link link-primary text-sm" href={allProjectsHref}
        >{copy.allProjects}</a
      >

      <div class="mt-6 flex flex-wrap gap-2">
        {
          project.categories.map((cat) => (
            <span class="badge badge-outline">{cat}</span>
          ))
        }
        {
          groupProject && (
            <span class="badge badge-sm badge-primary">
              {copy.groupProject}
            </span>
          )
        }
      </div>

      <h1 class="mt-4 text-4xl font-bold tracking-tight">{project.title}</h1>
      <p class="text-base-content/70 mt-4 max-w-3xl text-lg">
        {project.summary}
      </p>

      <div class="mt-5 flex flex-wrap gap-2">
        {
          project.stack.map((item) => (
            <span class="badge badge-outline">{item}</span>
          ))
        }
      </div>

      {
        project.highlights.length > 0 && (
          <div class="border-base-300 bg-base-200 mt-10 rounded-xl border p-6">
            <h2 class="text-lg font-semibold">{copy.technicalHighlights}</h2>
            <ul class="mt-4 space-y-2">
              {project.highlights.map((point) => (
                <li class="text-base-content/75 flex items-start gap-3">
                  <span class="text-primary mt-0.5" aria-hidden="true">
                    ▸
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        proseSections.length > 0 && (
          <div class="mt-10 max-w-3xl space-y-10">
            {proseSections.map(({ heading, content }) => (
              <div>
                <h2 class="text-xl font-semibold">{heading}</h2>
                <p class="text-base-content/75 mt-3 leading-relaxed">
                  {content}
                </p>
              </div>
            ))}
          </div>
        )
      }

      <div class="mt-12 flex flex-wrap gap-3">
        {
          project.githubUrl && (
            <a
              href={project.githubUrl}
              class="btn btn-outline"
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.viewOnGitHub}
            </a>
          )
        }
        {
          project.liveUrl && (
            <a
              href={project.liveUrl}
              class="btn btn-primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.liveDemo}
            </a>
          )
        }
        <a href={allProjectsHref} class="btn btn-ghost">{copy.allProjects}</a>
      </div>
    </Section>
  </main>
</BaseLayout>
