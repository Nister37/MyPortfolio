---
import { footerCopy, siteMetadata } from "../../data/site-copy";

interface Props {
  lang?: "en" | "pl";
}
const { lang = "en" } = Astro.props;
const year = new Date().getFullYear();
const copyright = `© ${year} ${siteMetadata.name}. ${footerCopy[lang].builtWith}`;
---

<footer class="border-base-300 bg-base-200 border-t">
  <div class="mx-auto max-w-[1120px] px-4 py-6">
    <p class="text-base-content/50 text-center text-xs">
      {copyright}
    </p>
    <p
      class="text-base-content/40 mx-auto mt-2 max-w-2xl text-center text-[0.7rem] leading-relaxed"
    >
      {footerCopy[lang].privacy}
    </p>
  </div>
</footer>
