---
import { blogCopy } from "../../data/site-copy";
import type { BlogPost } from "../../lib/cms/posts";
import { base } from "../../lib/url";
interface Props {
  post: BlogPost;
  lang?: "en" | "pl";
}
const { post, lang = "en" } = Astro.props;
const copy = blogCopy[lang];
const postHref =
  lang === "pl" ? `${base}pl/blog/${post.slug}` : `${base}blog/${post.slug}`;
const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString(
      lang === "pl" ? "pl-PL" : "en-GB",
      {
        day: "numeric",
        month: "short",
        year: "numeric",
      },
    )
  : null;
---

<article
  class="card bg-base-200 hover:ring-primary/40 relative shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg hover:ring-1"
>
  <!-- Stretched link covers the entire card. Card content sits at the same
       stacking context but inner interactive elements (none here) would need
       `relative z-10` to stay clickable above this overlay. -->
  <a
    href={postHref}
    class="focus-visible:ring-primary absolute inset-0 z-0 rounded-[inherit] focus:outline-none focus-visible:ring-2"
    aria-label={post.title}></a>
  <div class="card-body pointer-events-none relative z-[1] gap-3">
    <div class="flex flex-wrap items-center gap-2">
      {
        (post.tags ?? []).map((tag) => (
          <span class="badge badge-outline badge-sm">{tag}</span>
        ))
      }
    </div>
    <h3 class="card-title text-lg leading-snug">{post.title}</h3>
    <p class="text-base-content/65 text-sm">{post.description}</p>
    <div class="text-base-content/45 mt-1 flex items-center gap-3 text-xs">
      {
        formattedDate && (
          <time datetime={post.publishedAt}>{formattedDate}</time>
        )
      }
      {
        post.readingTime && (
          <span>
            {post.readingTime} {copy.minRead}
          </span>
        )
      }
    </div>
  </div>
</article>
