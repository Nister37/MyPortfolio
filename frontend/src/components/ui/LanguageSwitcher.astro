---
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  currentLang: "en" | "pl";
  /** Current page path without locale prefix, e.g. "/" or "/projects" */
  path: string;
  /** Optional locale-specific paths for translated pages with different slugs. */
  localePaths?: Partial<Record<"en" | "pl", string>>;
}

const { currentLang, path, localePaths } = Astro.props;

const enUrl = getRelativeLocaleUrl("en", localePaths?.en ?? path);
const plUrl = getRelativeLocaleUrl("pl", localePaths?.pl ?? path);
---

<div class="flex items-center gap-1 text-sm font-medium">
  <a
    href={enUrl}
    class:list={[
      "mobile-touch-target inline-flex items-center justify-center rounded px-2 py-2 transition-colors md:py-0.5",
      currentLang === "en"
        ? "bg-base-300 text-base-content"
        : "text-base-content/50 hover:text-base-content",
    ]}
    aria-current={currentLang === "en" ? "true" : undefined}
  >
    EN
  </a>
  <span class="text-base-content/30">/</span>
  <a
    href={plUrl}
    class:list={[
      "mobile-touch-target inline-flex items-center justify-center rounded px-2 py-2 transition-colors md:py-0.5",
      currentLang === "pl"
        ? "bg-base-300 text-base-content"
        : "text-base-content/50 hover:text-base-content",
    ]}
    aria-current={currentLang === "pl" ? "true" : undefined}
  >
    PL
  </a>
</div>
