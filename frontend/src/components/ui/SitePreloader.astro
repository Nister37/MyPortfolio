---
interface Props {
  lang?: "en" | "pl";
}

const { lang = "en" } = Astro.props;
const label = lang === "pl" ? "Ładowanie strony..." : "Loading website...";
const subtitle = "Preparing for the best experience";
---

<div
  id="site-preloader"
  class="site-preloader"
  aria-label={label}
  role="status"
>
  <div class="site-preloader__content">
    <div class="site-preloader__spinner" aria-hidden="true">
      <div class="site-preloader__ring"></div>
      <span class="site-preloader__prompt">&gt;_</span>
    </div>
    <p class="site-preloader__text">{subtitle}</p>
  </div>
</div>

<style>
  .site-preloader {
    position: fixed;
    inset: 0;
    z-index: 99998;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-base-100);
    transform: translateY(0);
    transition:
      transform 620ms cubic-bezier(0.77, 0, 0.175, 1),
      opacity 520ms cubic-bezier(0.77, 0, 0.175, 1),
      visibility 620ms;
    pointer-events: auto;
    will-change: transform, opacity;
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.35);
  }

  .site-preloader.is-loaded {
    transform: translateY(-100%);
    opacity: 0.96;
    visibility: hidden;
    pointer-events: none;
  }

  .site-preloader__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .site-preloader__spinner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
  }

  .site-preloader__ring {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid
      color-mix(in srgb, var(--color-primary, #3b82f6) 20%, transparent);
    border-top-color: var(--color-primary, #3b82f6);
    animation: preloader-spin 0.85s linear infinite;
    will-change: transform;
    transform: translateZ(0);
    contain: strict;
  }

  .site-preloader__prompt {
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary, #3b82f6);
    animation: preloader-pulse 1.6s ease-in-out infinite;
    will-change: transform, opacity;
    transform: translateZ(0);
  }

  .site-preloader__text {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-base-content, #e2e8f0);
    opacity: 0.78;
    letter-spacing: -0.01em;
    animation: preloader-text-in 0.4s ease-out both;
  }

  @keyframes preloader-spin {
    from {
      transform: rotate(0deg) translateZ(0);
    }
    to {
      transform: rotate(360deg) translateZ(0);
    }
  }

  @keyframes preloader-pulse {
    0%,
    100% {
      opacity: 0.6;
      transform: scale(0.96) translateZ(0);
    }
    50% {
      opacity: 1;
      transform: scale(1.04) translateZ(0);
    }
  }

  @keyframes preloader-text-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 0.78;
      transform: translateY(0);
    }
  }
</style>

<script>
  (function () {
    const preloader = document.getElementById("site-preloader");
    if (!preloader) return;

    // Handle back-forward cache restoration (bfcache) - page restored from memory snapshot
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) {
        preloader.remove();
      }
    });

    let dismissed = false;

    function dismiss() {
      if (dismissed || !preloader) return;
      dismissed = true;
      preloader.classList.add("is-loaded");
      setTimeout(() => {
        preloader?.remove();
      }, 650);
    }

    if (window.__portfolioShaderReady || window.__portfolioReady) {
      dismiss();
    } else {
      window.addEventListener("portfolio-ready", dismiss, { once: true });
    }

    // Safety fallback timeout so the curtain never hangs indefinitely
    setTimeout(dismiss, 1200);
  })();
</script>
