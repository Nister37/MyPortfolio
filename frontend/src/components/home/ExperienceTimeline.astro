---
import Section from "../layout/Section.astro";
import { homeCopy } from "../../data/site-copy";
import { getTimelineEntries } from "../../data/timeline";
import type { TimelineEntryType } from "../../data/timeline";
import { base } from "../../lib/url";
import "../../styles/components/experience-timeline.css";

interface Props {
  lang?: "en" | "pl";
}
const { lang = "en" } = Astro.props;
const copy = homeCopy[lang].experience;

const blogBase = lang === "pl" ? `${base}pl/blog/` : `${base}blog/`;
const entries = getTimelineEntries(lang);

const typeBadgeClass: Record<TimelineEntryType, string> = {
  Education: "badge-accent",
  Project: "badge-primary",
  Work: "badge-secondary",
};

// Two lifelines: education + professional experience on the left, projects on the right.
const educationEntries = entries.filter((entry) => entry.type === "Education" || entry.type === "Work");
const experienceEntries = entries.filter((entry) => entry.type === "Project");

const columns = [
  { heading: copy.educationHeading, entries: educationEntries },
  { heading: copy.projectsHeading, entries: experienceEntries },
];

function typeLabel(type: TimelineEntryType) {
  if (type === "Education") return copy.labels.education;
  if (type === "Project") return copy.labels.project;
  return copy.labels.work;
}
---

<Section id="experience">
  <div data-reveal>
    <h2 class="text-3xl font-bold tracking-tight">{copy.heading}</h2>
    <p class="mt-2 text-base-content/60">{copy.subheading}</p>
  </div>

  <!-- Stacked on mobile (with the per-column subheading above each list);
       side-by-side on desktop, each column its own continuous lifeline. -->
  <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-8">
    {
      columns.map((column) => (
        <div>
          <h3 class="mb-5 text-sm font-semibold uppercase tracking-wider text-base-content/60">
            {column.heading}
          </h3>
          <ol class="timeline-list space-y-4 border-l-2 border-base-300 pl-8">
            {column.entries.map((entry) => {
              const href = entry.blogSlug
                ? `${blogBase}${entry.blogSlug}`
                : entry.githubUrl;
              const isExternal = !entry.blogSlug && !!entry.githubUrl;
              return (
                <li class="relative">
                  <span
                    class="timeline-dot absolute -left-10 top-5 block h-3.5 w-3.5 rounded-full border-2 border-primary bg-base-100 transition-all"
                    aria-hidden="true"
                  />
                  <details class="timeline-card group rounded-lg border border-base-300 bg-base-200/40 transition-all">
                    <summary class="cursor-pointer list-none rounded-lg p-5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                      <div class="mb-1 flex flex-wrap items-center gap-2">
                        <span class="text-xs text-base-content/50">{entry.period}</span>
                        <span class:list={["badge badge-sm", typeBadgeClass[entry.type]]}>
                          {typeLabel(entry.type)}
                        </span>
                        <span class="ml-auto inline-flex items-center gap-1 text-xs text-primary/80">
                          {copy.labels.moreDetails}
                          <svg
                            class="timeline-card__chevron h-3.5 w-3.5 transition-transform"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            aria-hidden="true"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"></path>
                          </svg>
                        </span>
                      </div>
                      <h4 class="font-semibold">{entry.title}</h4>
                      <p class="text-sm text-base-content/60">{entry.organization}</p>
                    </summary>
                    {(entry.description || href) && (
                      <div class="border-t border-base-300 px-5 pb-5 pt-4">
                        {entry.description && (
                          <p class="text-sm text-base-content/70">{entry.description}</p>
                        )}
                        {href && (
                          <a
                            href={href}
                            target={isExternal ? "_blank" : undefined}
                            rel={isExternal ? "noopener noreferrer" : undefined}
                            class="btn btn-ghost btn-sm mt-3"
                          >
                            {entry.blogSlug
                              ? copy.labels.readArticle
                              : copy.labels.github}
                          </a>
                        )}
                      </div>
                    )}
                  </details>
                </li>
              );
            })}
          </ol>
        </div>
      ))
    }
  </div>
</Section>




