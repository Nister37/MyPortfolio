---
import ParticlesBackground from "../ui/ParticlesBackground.svelte";
import { homeCopy, siteMetadata } from "../../data/site-copy";
import { base } from "../../lib/url";
interface Props {
  lang?: "en" | "pl";
}
const { lang = "en" } = Astro.props;
const c = homeCopy[lang].hero;
---

<section class="relative overflow-hidden py-20 md:py-32">
  <ParticlesBackground client:load />
  <div class="relative z-10 mx-auto max-w-[1120px] px-4">
    <div class="max-w-3xl" data-reveal>
      <p class="mb-4 text-sm font-medium uppercase tracking-widest text-primary">
        {c.available}
      </p>

      <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-6xl">
        {siteMetadata.name}
      </h1>

      <p class="mt-4 text-xl font-medium text-base-content/80 md:text-2xl">
        {c.subtitle}
      </p>

      <p class="mt-6 max-w-2xl text-base leading-relaxed text-base-content/65">
        {c.body}
      </p>

      <p class="mt-3 text-sm text-base-content/50">
        {c.openTo}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={lang === "pl" ? `${base}pl/projects` : `${base}projects`}
          class="btn btn-primary"
        >
          {c.viewProjects}
        </a>
        <button type="button" class="btn btn-outline" data-cv-trigger>
          {c.downloadCv}
        </button>
      </div>
    </div>
  </div>
</section>
