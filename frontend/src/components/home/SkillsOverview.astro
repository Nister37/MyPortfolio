---
import Section from "../layout/Section.astro";
import { skillCategories } from "../../data/skills";
import type { SkillLevel } from "../../data/skills";

interface Props {
  lang?: "en" | "pl";
}
const { lang = "en" } = Astro.props;

const levels = [1, 2, 3, 4, 5] as const;

const categoryLabel: Record<string, Record<string, string>> = {
  en: { Backend: "Backend", DevOps: "DevOps", "AI & Automation": "AI & Automation", Frontend: "Frontend", Database: "Database" },
  pl: { Backend: "Backend", DevOps: "DevOps", "AI & Automation": "AI i automatyzacja", Frontend: "Frontend", Database: "Bazy danych" },
};

const legendLabels: Record<"en" | "pl", string[]> = {
  en: [">6 months", ">1 year", ">2 years", ">3 years", ">4 years"],
  pl: [">6 miesięcy", ">1 rok", ">2 lata", ">3 lata", ">4 lata"],
};

function meterLabel(level: SkillLevel) {
  return lang === "pl"
    ? `${level} z 5 pasków doświadczenia: ${legendLabels.pl[level - 1]}`
    : `${level} of 5 experience bars: ${legendLabels.en[level - 1]}`;
}
---

<Section id="skills">
  <div data-reveal>
    <h2 class="text-3xl font-bold tracking-tight">
      {lang === "pl" ? "Umiejętności techniczne" : "Skills"}
    </h2>
    <p class="mt-2 text-base-content/60">
      {lang === "pl"
        ? "Wybierz obszar, aby zobaczyć technologie i czas doświadczenia."
        : "Select a domain to see technologies and hands-on experience."}
    </p>
  </div>

  <div class="mt-10 grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      skillCategories.map(({ category, skills }) => (
        <details class="skill-card group rounded-xl border border-base-300 bg-base-200 transition-all">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl p-5 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary">
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-primary">
                {categoryLabel[lang][category] ?? category}
              </h3>
              <p class="mt-1 text-xs text-base-content/50">
                {skills.length} {lang === "pl" ? "technologii" : "technologies"}
              </p>
            </div>
            <svg
              class="skill-card__chevron h-4 w-4 shrink-0 text-primary transition-transform"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <ul class="space-y-3 border-t border-base-300 px-5 py-4">
            {skills.map(({ name, level }) => (
              <li class="flex items-center justify-between gap-3">
                <span class="text-sm font-medium text-base-content">{name}</span>
                <span
                  class="skill-meter"
                  data-level={level}
                  role="img"
                  aria-label={meterLabel(level)}
                  title={meterLabel(level)}
                >
                  {levels.map((bar) => (
                    <span
                      class:list={[
                        "skill-meter__bar",
                        bar <= level && "skill-meter__bar--active",
                      ]}
                      aria-hidden="true"
                    />
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>

  <div class="mt-6 rounded-xl border border-base-300 bg-base-200/50 p-5">
    <h3 class="text-sm font-semibold uppercase tracking-wider text-base-content/70">
      {lang === "pl" ? "Legenda doświadczenia" : "Experience legend"}
    </h3>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {
        levels.map((level) => (
          <div class="flex items-center gap-3">
            <span class="skill-meter" data-level={level} aria-hidden="true">
              {levels.map((bar) => (
                <span
                  class:list={[
                    "skill-meter__bar",
                    bar <= level && "skill-meter__bar--active",
                  ]}
                />
              ))}
            </span>
            <span class="text-xs text-base-content/65">{legendLabels[lang][level - 1]}</span>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .skill-card summary::-webkit-details-marker {
    display: none;
  }

  .skill-card[open] {
    border-color: color-mix(in srgb, var(--color-primary, #6366f1) 45%, transparent);
    box-shadow: 0 12px 30px -20px color-mix(in srgb, var(--color-primary, #6366f1) 65%, transparent);
  }

  .skill-card[open] .skill-card__chevron {
    transform: rotate(180deg);
  }

  .skill-meter {
    display: flex;
    width: 6.5rem;
    flex-shrink: 0;
    gap: 0.25rem;
  }

  .skill-meter__bar {
    height: 0.45rem;
    min-width: 0;
    flex: 1 1 0%;
    border-radius: 9999px;
    background-color: color-mix(in srgb, var(--color-base-content, #94a3b8) 14%, transparent);
    box-shadow: none;
  }

  .skill-meter[data-level="1"] .skill-meter__bar--active {
    background-color: color-mix(in srgb, var(--color-primary, #6366f1) 52%, transparent);
    box-shadow: 0 0 4px color-mix(in srgb, var(--color-primary, #6366f1) 24%, transparent);
  }

  .skill-meter[data-level="2"] .skill-meter__bar--active {
    background-color: color-mix(in srgb, var(--color-primary, #6366f1) 64%, transparent);
    box-shadow: 0 0 5px color-mix(in srgb, var(--color-primary, #6366f1) 32%, transparent);
  }

  .skill-meter[data-level="3"] .skill-meter__bar--active {
    background-color: color-mix(in srgb, var(--color-primary, #6366f1) 76%, transparent);
    box-shadow: 0 0 6px color-mix(in srgb, var(--color-primary, #6366f1) 40%, transparent);
  }

  .skill-meter[data-level="4"] .skill-meter__bar--active {
    background-color: color-mix(in srgb, var(--color-primary, #6366f1) 88%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--color-primary, #6366f1) 50%, transparent);
  }

  .skill-meter[data-level="5"] .skill-meter__bar--active {
    background-color: var(--color-primary, #6366f1);
    box-shadow: 0 0 10px color-mix(in srgb, var(--color-primary, #6366f1) 62%, transparent);
  }
</style>
