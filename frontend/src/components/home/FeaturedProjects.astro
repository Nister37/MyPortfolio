---
import { getFeaturedProjects } from "../../lib/cms/projects";
import ProjectStrip from "../projects/ProjectStrip.svelte";
import Section from "../layout/Section.astro";
import { homeCopy } from "../../data/site-copy";
import { base } from "../../lib/url";

interface Props {
  lang?: "en" | "pl";
}

const { lang = "en" } = Astro.props;
const copy = homeCopy[lang].featuredProjects;
const recentProjects = (await getFeaturedProjects()).slice(0, 3);
const projectBase = lang === "pl" ? base + "pl/projects/" : base + "projects/";
---

<Section id="projects" background="base-200">
  <div class="mb-6">
    <div>
      <h2 class="text-3xl font-bold tracking-tight">{copy.heading}</h2>
      <p class="text-base-content/60 mt-2 max-w-2xl">{copy.subheading}</p>
    </div>
  </div>

  <ProjectStrip
    client:load
    projects={recentProjects}
    projectBase={projectBase}
    lang={lang}
  />
</Section>
