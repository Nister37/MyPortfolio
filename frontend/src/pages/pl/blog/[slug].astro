---
import BlogPostPage from "../../../components/pages/BlogPostPage.astro";
import { getBlogPostLocalePaths, getPosts } from "../../../lib/cms/posts";
import type { BlogPost } from "../../../lib/cms/posts";

export async function getStaticPaths() {
  const allPosts = await getPosts();
  const posts = allPosts.filter((post) => (post.language ?? "en") === "pl");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, localePaths: getBlogPostLocalePaths(post, allPosts) },
  }));
}

interface Props {
  post: BlogPost;
  localePaths: Record<"en" | "pl", string>;
}

const { post, localePaths } = Astro.props;
---

<BlogPostPage post={post} localePaths={localePaths} lang="pl" />





