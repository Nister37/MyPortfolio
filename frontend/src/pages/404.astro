---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageCopy } from "../data/site-copy";
import { base } from "../lib/url";
import IconHeading from "../components/ui/IconHeading.astro";

const copy = pageCopy.en.notFound;
---

<BaseLayout title={copy.title} description={copy.description}>
  <main id="main-content">
    <section
      class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center"
    >
      <p class="text-primary text-6xl font-bold">404</p>
      <IconHeading icon="circle-alert" class="mt-4 text-2xl font-bold">
        {copy.heading}
      </IconHeading>
      <p class="text-base-content/60 mt-3">
        {copy.body}
      </p>
      <div class="mt-8 flex gap-3">
        <a href={base} class="btn btn-primary">{copy.home}</a>
      </div>
    </section>
  </main>
</BaseLayout>
